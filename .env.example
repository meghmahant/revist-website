# Public frontend configuration (safe for client bundle — NEVER put private secrets here)
# Site identity
VITE_BRAND_NAME=Revist
VITE_WEBSITE_URL=https://therevist.in

# Public contact details (leave empty to hide unconfigured links)
VITE_BUSINESS_EMAIL=
VITE_BUSINESS_PHONE=

# Lead submission endpoint (Cloudflare Worker proxy URL or Google Apps Script Web App URL)
# Leave empty until backend is deployed; form remains in safe unconfigured/test state
VITE_LEAD_ENDPOINT=

# Existing separate restaurant dashboard URL (leave empty until confirmed)
VITE_CLIENT_DASHBOARD_URL=

# Product & legal metadata
VITE_DEFAULT_INACTIVITY_THRESHOLD=21
VITE_TRIAL_DURATION_DAYS=30
VITE_PRIVACY_POLICY_VERSION=2026-11-draft-v1
VITE_TERMS_VERSION=2026-11-draft-v1
